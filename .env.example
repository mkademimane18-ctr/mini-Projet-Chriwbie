# Copiez ce fichier vers .env en local et renseignez vos propres valeurs.
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=chriwbie
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password

# Clé temporaire pour créer le premier compte administrateur.
# Après la création, retirez cette variable de l'environnement serveur.
ADMIN_SETUP_KEY=replace-with-a-long-random-secret

# Configuration Cloudinary utilisée par l'upload des photos.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
